{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Human review rubric",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "rubricId",
    "criteria"
  ],
  "properties": {
    "rubricId": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$"
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "question",
          "scale"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$"
          },
          "question": {
            "type": "string",
            "maxLength": 300
          },
          "scale": {
            "type": "string",
            "enum": [
              "yes_no",
              "one_to_five"
            ]
          },
          "blocking": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
