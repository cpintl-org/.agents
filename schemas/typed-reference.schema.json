{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TypedReference: a pointer that says what it points to",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "name"
  ],
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "AgentTask",
        "AgentWorkspace",
        "AgentPolicy",
        "ModelAdapter",
        "AgentTemplate",
        "AgentInstance",
        "CheckpointPolicy",
        "Source"
      ]
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$"
    },
    "uri": {
      "type": "string",
      "maxLength": 500
    }
  }
}
