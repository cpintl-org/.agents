{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentPolicy: rules a run must follow",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "const": "agents.cpintl.org/v1alpha1"
    },
    "kind": {
      "const": "AgentPolicy"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$"
        },
        "owner": {
          "type": "string",
          "maxLength": 128
        },
        "description": {
          "type": "string",
          "maxLength": 500
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sensitivity",
        "network",
        "humanReviewRequired"
      ],
      "properties": {
        "sensitivity": {
          "type": "string",
          "enum": [
            "public",
            "internal",
            "restricted"
          ]
        },
        "network": {
          "type": "string",
          "enum": [
            "deny-by-default",
            "allowlist"
          ]
        },
        "allowedHosts": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "string",
            "maxLength": 253
          }
        },
        "humanReviewRequired": {
          "type": "boolean"
        },
        "allowExternalWrite": {
          "type": "boolean"
        },
        "allowAiForRestrictedData": {
          "type": "boolean"
        },
        "retentionDays": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3650
        }
      }
    }
  }
}
