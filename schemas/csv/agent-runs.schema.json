{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "agent-runs CSV row",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "runId",
    "taskId",
    "phase",
    "startedOn",
    "ownerRole",
    "outcome",
    "notes"
  ],
  "properties": {
    "runId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,128}$"
    },
    "taskId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,128}$"
    },
    "phase": {
      "type": "string",
      "enum": [
        "created",
        "preparing",
        "executing",
        "waiting_for_review",
        "reviewing",
        "completed",
        "paused",
        "aborted",
        "error"
      ]
    },
    "startedOn": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}|{YYYY-MM-DD}$"
    },
    "ownerRole": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "outcome": {
      "type": "string",
      "enum": ["", "success", "failure", "blocked", "manual_review"]
    },
    "notes": {
      "type": "string",
      "maxLength": 2000
    }
  }
}