{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "agent-sources CSV row",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sourceId",
    "sourceType",
    "locator",
    "revision",
    "freshness",
    "sensitivity",
    "ownerRole",
    "lastCheckedOn",
    "reviewEveryDays"
  ],
  "properties": {
    "sourceId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,128}$"
    },
    "sourceType": {
      "type": "string",
      "enum": ["repository", "drive", "web", "internal-system", "other"]
    },
    "locator": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "freshness": {
      "type": "string",
      "enum": ["current", "stale", "unknown", "never-checked"]
    },
    "sensitivity": {
      "type": "string",
      "enum": ["public", "internal", "restricted"]
    },
    "ownerRole": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "lastCheckedOn": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}|{YYYY-MM-DD}$"
    },
    "reviewEveryDays": {
      "type": "integer",
      "minimum": 0
    }
  }
}