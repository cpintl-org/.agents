{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LifecycleCondition: one yes/no fact about a run",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "status"
  ],
  "properties": {
    "type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "status": {
      "type": "string",
      "enum": [
        "True",
        "False",
        "Unknown"
      ]
    },
    "reason": {
      "type": "string",
      "maxLength": 128
    },
    "message": {
      "type": "string",
      "maxLength": 500
    },
    "lastChangedAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
