{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Prompt file header (frontmatter)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "version",
    "owner",
    "sensitivity",
    "input_schema",
    "output_schema"
  ],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "owner": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "description": {
      "type": "string",
      "maxLength": 500
    },
    "sensitivity": {
      "type": "string",
      "enum": [
        "public",
        "internal",
        "restricted"
      ]
    },
    "input_schema": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._/-]+$",
      "not": {
        "pattern": "\\.\\."
      }
    },
    "output_schema": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._/-]+$",
      "not": {
        "pattern": "\\.\\."
      }
    },
    "fixtures": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._/-]+$",
      "not": {
        "pattern": "\\.\\."
      }
    },
    "requires": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$"
      }
    }
  }
}
