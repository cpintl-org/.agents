{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "evidence-summary input",
  "type": "object",
  "additionalProperties": false,
  "required": ["topic", "sources"],
  "properties": {
    "topic": {"type": "string", "minLength": 1, "maxLength": 300},
    "audience": {"type": "string", "maxLength": 200},
    "sources": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"type": "string", "maxLength": 500}}
  }
}
