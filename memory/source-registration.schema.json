{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Source registration: an approved source for memory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sourceId",
    "type",
    "locator",
    "sensitivity",
    "ownerRole",
    "approvedBy",
    "approvedOn"
  ],
  "properties": {
    "sourceId": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$"
    },
    "type": {
      "type": "string",
      "enum": [
        "repository",
        "google_drive",
        "google_sheet",
        "url",
        "manual"
      ]
    },
    "locator": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "sensitivity": {
      "type": "string",
      "enum": [
        "public",
        "internal",
        "restricted"
      ]
    },
    "ownerRole": {
      "type": "string",
      "maxLength": 128
    },
    "approvedBy": {
      "type": "string",
      "maxLength": 128
    },
    "approvedOn": {
      "type": "string",
      "format": "date"
    },
    "excludePatterns": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "string",
        "maxLength": 200
      }
    },
    "reviewEveryDays": {
      "type": "integer",
      "minimum": 1,
      "maximum": 365
    }
  }
}
